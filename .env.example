# ============================================================
# VIGIL — Environment Variables Template
# Copy to .env and fill in actual values
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vigil
POSTGRES_USER=vigil
POSTGRES_PASSWORD=changeme_postgres

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8085

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=vigil
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://vigil:changeme_postgres@postgres:5432/mlflow

# --- Flink ---
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_JOBMANAGER_PORT=8081

# --- JWT / Auth ---
JWT_SECRET_KEY=changeme_jwt_secret_256bit
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI APIs (async only — never on critical path) ---
ANTHROPIC_API_KEY=sk-ant-CHANGEME
GEMINI_API_KEY=CHANGEME

# --- Service Discovery (gRPC endpoints) ---
USER_CONTEXT_GRPC_HOST=user-context
USER_CONTEXT_GRPC_PORT=50050
FRICTION_CLASSIFIER_GRPC_HOST=friction-classifier
FRICTION_CLASSIFIER_GRPC_PORT=50051
INTERVENTION_ENGINE_GRPC_HOST=intervention-engine
INTERVENTION_ENGINE_GRPC_PORT=50052

# --- Tenant Defaults ---
DEFAULT_TENANT_ID=demo-tenant

# --- Environment ---
VIGIL_ENV=development
LOG_LEVEL=INFO
